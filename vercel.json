{
  "buildCommand": "npm run build",
  "outputDirectory": "packages/gephi-lite/build",
  "rewrites": [
    {
      "source": "/comin-api/graph/contexts",
      "destination": "/api/comin/graph/contexts"
    },
    {
      "source": "/comin-api/graph/contexts/:theme_id/units",
      "destination": "/api/comin/graph/contexts/:theme_id/units"
    },
    {
      "source": "/comin-api/graph/contexts/:theme_id/posts",
      "destination": "/api/comin/graph/contexts/:theme_id/posts"
    },
    {
      "source": "/comin-api/graph/contexts/:theme_id/children",
      "destination": "/api/comin/graph/contexts/:theme_id/children"
    }
  ]
}
